# Copy this file to .env and fill in the values.

# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Any contact URI — required by the Web Push protocol so push services can
# reach you if something's wrong with your usage. A mailto: link is easiest.
VAPID_SUBJECT=mailto:you@example.com

# How often (ms) to poll the GBFS feed. 30000 = 30s.
POLL_INTERVAL_MS=30000

# Optional — Express defaults to 3000 if unset.
PORT=3000
